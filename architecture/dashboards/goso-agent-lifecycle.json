        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Conversation Takeover & Human Hold Lifecycle",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "events/sec" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Takeover Events Rate (crm_takeover_events_total)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(crm_takeover_events_total[5m])) by (tenant_id, channel_type, trigger_type)",
          "legendFormat": "{{tenant_id}} - {{channel_type}} ({{trigger_type}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "suppressions/sec" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Bot Replies Suppressed (crm_bot_replies_suppressed_total)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(crm_bot_replies_suppressed_total[5m])) by (tenant_id, reason)",
          "legendFormat": "{{tenant_id}} (reason: {{reason}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Human Hold Duration p95 (crm_human_hold_duration_seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(crm_human_hold_duration_seconds_bucket[5m])) by (le, tenant_id))",
          "legendFormat": "p95 hold - {{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "GOSO Webhook & Agent Hands Ingress/Egress",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 4,
      "title": "GOSO Webhook Requests Total (aiagent_goso_webhook_requests_total)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aiagent_goso_webhook_requests_total[5m])) by (endpoint, status_code)",
          "legendFormat": "{{endpoint}} - status: {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 5,
      "title": "GOSO Webhook Latency p99 (aiagent_goso_webhook_duration_seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(aiagent_goso_webhook_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p99 latency - {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 6,
      "title": "Agent Hands Tool Calls (aiagent_hands_tool_calls_total)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aiagent_hands_tool_calls_total[5m])) by (tool_name, autonomy_level, status)",
          "legendFormat": "{{tool_name}} [{{autonomy_level}}] ({{status}})",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["goso", "aiagent", "crm", "takeover"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "GOSO AI Agent Lifecycle & Realtime Operations",
  "uid": "goso-agent-lifecycle",
  "version": 1
}
